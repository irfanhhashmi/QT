rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pages/{pageId} {
      allow read, write: if true;
    }

    match /blogs/{blogId} {
      allow read, write: if true;
      
      match /comments/{commentId} {
        allow read, write: if true;
      }
      
      match /likes/{userId} {
        allow read, write: if true;
      }
    }
    
    match /userProfiles/{uid} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if false; // Writing should be handled via authenticated Admin Console logic elsewhere
    }
  }
}
