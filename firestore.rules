rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pages/{pageId} {
      allow read, write: if true;
    }

    match /blogs/{blogId} {
      allow read, write: if true;
      
      match /comments/{commentId} {
        allow read, write: if true;
      }
      
      match /likes/{userId} {
        allow read, write: if true;
      }
    }
    
    match /userProfiles/{uid} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    // Signaling rules for P2P matchmaking and calls on Vercel/Static
    match /qt_queue/{docId} {
      allow read, write: if true;
    }

    match /qt_diagnostics/{docId} {
      allow read, write: if true;
    }

    match /qt_rooms/{roomId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
  }
}
